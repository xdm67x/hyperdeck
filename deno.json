{
    "nodeModulesDir": "auto",
    "tasks": {
        "dev": "deno run -A npm:vite",
        "build": "deno run -A npm:vite build",
        "preview": "deno run -A npm:vite preview",
        "lint": "deno run -A npm:oxlint",
        "fmt": "deno run -A npm:oxfmt --write .",
        "fmt:check": "deno run -A npm:oxfmt --check ."
    },
    "imports": {
        "highlight.js": "npm:highlight.js@^11.12.0",
        "monaco-editor": "npm:monaco-editor@^0.52.2",
        "preact": "npm:preact@^10.26.2",
        "preact/jsx-runtime": "npm:preact@^10.26.2/jsx-runtime",
        "preact/hooks": "npm:preact@^10.26.2/hooks",
        "preact/compat": "npm:preact@^10.26.2/compat",
        "@preact/signals": "npm:@preact/signals@^1.3.1",
        "dexie": "npm:dexie@^4.0.11",
        "vite": "npm:vite@^6.3.5",
        "@preact/preset-vite": "npm:@preact/preset-vite@^2.9.6",
        "tailwindcss": "npm:tailwindcss@^4.1.13",
        "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.1.13",
        "marked": "npm:marked@^18.1.0",
        "oxlint": "npm:oxlint@^1.87.0",
        "oxfmt": "npm:oxfmt@^0.72.0"
    },
    "compilerOptions": {
        "jsx": "react-jsx",
        "jsxImportSource": "preact"
    }
}
